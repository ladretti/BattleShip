@inject Random Random

@* Draws one board from the cells the SERVER described, and reports clicks. It decides
   nothing — not even whether a cell may be fired at again: that refusal belongs to the
   server, and letting the click through is what makes it demonstrable (ADR 0005). *@

<div class="board-frame">
    <div class="board" role="group" aria-label="@Label"
         style="grid-template-columns: auto repeat(@GridSize, var(--cell-size, 2.15rem));">

        @* Coordinate rulers. Not decoration: naming a cell out loud is how the game has
           always been played, and the aria-labels below use the same names. *@
        <span class="ruler" aria-hidden="true"></span>
        @for (var x = 0; x < GridSize; x++)
        {
            <span class="ruler" aria-hidden="true">@Column(x)</span>
        }

        @for (var y = 0; y < GridSize; y++)
        {
            var row = y;
            <span class="ruler" aria-hidden="true">@(row + 1)</span>

            @for (var x = 0; x < GridSize; x++)
            {
                var column = x;
                var index = row * GridSize + column;
                var cell = new Coordinate(column, row);
                var state = StateOf(cell);

                var struck = Impact is { } mark && mark.At == cell;

                @if (Interactive)
                {
                    @* Roving tabindex: exactly one cell of the grid is in the tab order, so Tab
                       steps over the whole board in one press instead of walking GridSize² cells,
                       and the arrow keys move within it. This is the standard keyboard pattern
                       for a grid, and it is what makes the game playable without a mouse. *@
                    <button type="button" class="cell @state @(struck ? "is-struck" : null)"
                            aria-label="@LabelFor(cell, state)"
                            @ref="_cellRefs[index]"
                            tabindex="@(index == _focused ? 0 : -1)"
                            @onclick="() => OnCellClick.InvokeAsync(cell)"
                            @onfocus="() => _focused = index"
                            @onkeydown="args => MoveFocusAsync(args, index)">
                        <span aria-hidden="true">@Glyph(state)</span>
                        @if (struck) { @Burst(Impact!) }
                    </button>
                }
                else
                {
                    <div class="cell @state @(struck ? "is-struck" : null)" role="img"
                         aria-label="@LabelFor(cell, state)">
                        <span aria-hidden="true">@Glyph(state)</span>
                        @if (struck) { @Burst(Impact!) }
                    </div>
                }
            }
        }

    </div>

    @if (Impact is { Kind: "sunk" } sinking)
    {
        <div class="sunk-stamp" aria-hidden="true">
            <span @key="sinking.Sequence">@(SunkLabel ?? "Sunk")</span>
        </div>
    }
</div>

@* The burst is rendered INSIDE the cell that was struck, never as a grid item of its own.
   Placing it explicitly in the grid made CSS auto-placement route the following cells
   around it, which pushed the whole board one square out of line and grew a phantom
   twelfth row — visible only in the browser, never in a test. As a child of the cell it
   needs no measuring, survives a resize, and cannot disturb the layout. *@
@{
    RenderFragment Burst(ImpactMark impact) =>
        @<span @key="impact.Sequence" class="impact impact--@impact.Kind" aria-hidden="true">
            <span class="impact__flash"></span>
            <span class="impact__ring"></span>
            <span class="impact__ring impact__ring--late"></span>
            @foreach (var shard in Shards(impact.Kind))
            {
                <span class="impact__shard" style="@shard"></span>
            }
        </span>;
}

@code {
    /// <summary>
    /// The shot to play an impact for. <see cref="ImpactMark.Sequence"/> is what makes a
    /// repeat of the same cell, or two hits in a row, restart the animation instead of
    /// leaving the previous one frozen on screen.
    /// </summary>
    public sealed record ImpactMark(Coordinate At, string Kind, int Sequence);

    [Parameter, EditorRequired] public int GridSize { get; set; }

    /// <summary>
    /// Every cell the player is entitled to see on this board, exactly as the server
    /// projected it. Duplicates are allowed and the last one wins, which is how a "sunk"
    /// cell overrides the "hit" that discovered it.
    /// </summary>
    [Parameter, EditorRequired] public IReadOnlyList<CellDto> Cells { get; set; } = [];

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public bool Interactive { get; set; }

    [Parameter] public ImpactMark? Impact { get; set; }

    /// <summary>The name stamped across the board when a hull goes down.</summary>
    [Parameter] public string? SunkLabel { get; set; }

    [Parameter] public EventCallback<Coordinate> OnCellClick { get; set; }

    private Dictionary<Coordinate, string> _states = [];
    private ElementReference[] _cellRefs = [];
    private int _focused;

    protected override void OnParametersSet()
    {
        _states = [];
        foreach (var cell in Cells)
            _states[new Coordinate(cell.X, cell.Y)] = cell.State;

        if (_cellRefs.Length != GridSize * GridSize)
            _cellRefs = new ElementReference[GridSize * GridSize];

        // A smaller grid could otherwise leave the roving tabindex pointing past the end,
        // and no cell at all would be reachable by Tab.
        _focused = Math.Clamp(_focused, 0, Math.Max(0, _cellRefs.Length - 1));
    }

    /// <summary>
    /// Puts keyboard focus back on a given cell. The page calls this after an exchange:
    /// firing swaps the board from buttons to inert cells and back, which REPLACES the
    /// focused element, so focus would otherwise fall back to the document body and a
    /// keyboard player would have to tab all the way in again before every shot.
    ///
    /// Returns false, and does nothing, while the grid is not interactive — during the
    /// exchange there is no button to focus. The caller keeps its request pending and tries
    /// again on the next render rather than dropping it, which is the whole difficulty: the
    /// first render after a shot is the one where the board is still inert.
    /// </summary>
    public async Task<bool> FocusCellAsync(Coordinate cell)
    {
        var index = cell.Y * GridSize + cell.X;
        if (!Interactive || index < 0 || index >= _cellRefs.Length)
            return false;

        _focused = index;
        await _cellRefs[index].FocusAsync();
        return true;
    }

    /// <summary>
    /// Arrow keys move within the grid; Home and End jump to the ends of the current row.
    /// Enter and Space are not handled here on purpose — a <c>&lt;button&gt;</c> already
    /// activates on both, and re-implementing that would only risk firing twice.
    /// </summary>
    private async Task MoveFocusAsync(KeyboardEventArgs args, int index)
    {
        var row = index / GridSize;
        var column = index % GridSize;

        var target = args.Key switch
        {
            "ArrowRight" => column + 1 < GridSize ? index + 1 : index,
            "ArrowLeft" => column > 0 ? index - 1 : index,
            "ArrowDown" => row + 1 < GridSize ? index + GridSize : index,
            "ArrowUp" => row > 0 ? index - GridSize : index,
            "Home" => row * GridSize,
            "End" => row * GridSize + GridSize - 1,
            _ => index
        };

        if (target == index)
            return;

        _focused = target;
        await _cellRefs[target].FocusAsync();
    }

    /// <summary>
    /// The debris flung by an impact, as inline custom properties the stylesheet animates.
    /// Randomness is injected rather than taken from Random.Shared — the same discipline the
    /// engine follows. Here it only decides where sparks fly, but an exception to that rule
    /// is not worth arguing for.
    /// </summary>
    private IEnumerable<string> Shards(string kind)
    {
        var count = kind == "miss" ? 6 : 12;
        var reach = kind == "miss" ? 26 : 52;

        for (var i = 0; i < count; i++)
        {
            var angle = (2 * Math.PI * i / count) + (Random.NextDouble() * 0.5);
            var distance = reach * (0.55 + (Random.NextDouble() * 0.75));
            var dx = Math.Round(Math.Cos(angle) * distance, 1);
            var dy = Math.Round(Math.Sin(angle) * distance, 1);
            var size = kind == "miss" ? 3 + Random.Next(3) : 4 + Random.Next(5);
            var delay = Random.Next(0, 90);

            yield return
                $"--dx:{Css(dx)}px;--dy:{Css(dy)}px;--s:{size}px;--d:{delay}ms";
        }
    }

    /// <summary>
    /// CSS never accepts a decimal comma, and this app runs under whatever locale the
    /// player's browser reports — so the invariant culture is not optional here.
    /// </summary>
    private static string Css(double value) =>
        value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private string StateOf(Coordinate cell) => _states.GetValueOrDefault(cell, "unknown");

    /// <summary>Column names as the game says them out loud: A, B, C…</summary>
    private static string Column(int x) => ((char)('A' + x)).ToString();

    /// <summary>
    /// A glyph per state, so the five states stay distinguishable <b>without colour</b> —
    /// for a colour-blind player, in high contrast mode, or on a printed screenshot. The
    /// glyphs are identical in all three skins: a theme changes the material, never the
    /// information.
    /// </summary>
    private static string Glyph(string state) => state switch
    {
        "ship" => "■",
        "miss" => "·",
        "hit" => "✱",
        "sunk" => "✖",
        _ => ""
    };

    private static string LabelFor(Coordinate cell, string state)
    {
        var what = state switch
        {
            "miss" => "miss",
            "hit" => "hit",
            "sunk" => "sunk",
            "ship" => "your ship",
            _ => "not fired at"
        };

        return $"{Column(cell.X)}{cell.Y + 1}, {what}";
    }
}

@implements IAsyncDisposable
@inject IJSRuntime Js
@inject AppearanceState Appearance

<canvas @ref="_canvas" class="scene-canvas" aria-hidden="true"></canvas>

@code {
    [Parameter] public SceneState? State { get; set; }

    private ElementReference _canvas;
    private bool _ready;
    private bool _disposed;
    private SceneState? _sent;
    private bool _osPrefersStill;
    private bool? _sentCalm;

    private bool Calm => _osPrefersStill || Appearance.Motion == "calm";

    protected override void OnInitialized() => Appearance.OnChange += OnAppearanceChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _ready = await Js.InvokeAsync<bool>("battleshipScene.init", _canvas);
                if (_ready)
                    _osPrefersStill = await Js.InvokeAsync<bool>("battleshipSettings.prefersReducedMotion");
            }
            catch (JSException)
            {
                _ready = false;
            }
        }

        if (_disposed || !_ready)
            return;

        if (_sentCalm != Calm)
        {
            _sentCalm = Calm;
            try
            {
                await Js.InvokeVoidAsync("battleshipScene.freeze", Calm);
            }
            catch (JSException)
            {
            }
        }

        if (State is not null && !ReferenceEquals(State, _sent))
        {
            _sent = State;
            try
            {
                await Js.InvokeVoidAsync("battleshipScene.update", State);
            }
            catch (JSException)
            {
            }
        }
    }

    private void OnAppearanceChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Appearance.OnChange -= OnAppearanceChanged;
        _disposed = true;

        if (!_ready)
            return;

        try
        {
            await Js.InvokeVoidAsync("battleshipScene.dispose");
        }
        catch (JSException)
        {
        }
    }
}

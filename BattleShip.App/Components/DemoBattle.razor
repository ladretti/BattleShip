@using BattleShip.App.Rendering
@implements IAsyncDisposable
@inject AppearanceState Appearance
@inject IJSRuntime Js

@* A fleet under fire, playing itself on the front page.

   It is not an illustration of the game: it IS the game's own components — the same board,
   the same hulls, the same impact choreography, the same skin the player has chosen. Nothing
   here is a second visual language to keep in step with the first.

   It shows YOUR board rather than the opponent's, which is what lets the hulls be visible
   while they are being hit. On the opponent's board an afloat ship has nothing to draw, by
   the secrecy rule — showing one here would be advertising something the game never does. *@

<div class="demo" aria-hidden="true">
    <FiringGrid GridSize="Size"
                Cells="Cells"
                Ships="Fleet"
                Impact="_impact"
                SunkLabel="@_sunkLabel"
                Label="A fleet under fire"
                Interactive="false" />
</div>

@code {
    private const int Size = 8;

    /// <summary>
    /// The fleet, and the order the shots land in — written out rather than randomised. A
    /// front page gets one chance to be watched, and a random sequence spends most of it
    /// missing. This one misses enough to feel real, then takes each ship apart.
    /// </summary>
    private static readonly (string Name, Coordinate Origin, bool Vertical, int Size)[] Fleet0 =
    [
        ("Carrier", new Coordinate(1, 1), false, 4),
        ("Cruiser", new Coordinate(6, 1), true, 3),
        ("Destroyer", new Coordinate(1, 4), false, 2),
        ("Submarine", new Coordinate(3, 6), false, 3)
    ];

    private static readonly Coordinate[] Misses =
    [
        new(0, 0), new(7, 7), new(4, 3), new(0, 3),
        new(7, 0), new(2, 2), new(5, 5), new(1, 7)
    ];

    private Coordinate[] _script = [];
    private readonly Dictionary<Coordinate, string> _resolved = [];
    private FiringGrid.ImpactMark? _impact;
    private string? _sunkLabel;
    private int _step;
    private int _sequence;

    private CancellationTokenSource? _cts;
    private bool _frozen;

    private IReadOnlyList<CellDto> Cells =>
    [
        .. AllShipCells().Select(c => new CellDto(c.At.X, c.At.Y, c.State)),
        .. _resolved.Where(r => r.Value == "miss").Select(r => new CellDto(r.Key.X, r.Key.Y, "miss"))
    ];

    private IReadOnlyList<ShipOutline> Fleet =>
    [
        .. Fleet0
            .Select(ship =>
            {
                IReadOnlyList<CellDto> cells =
                [
                    .. CellsOf(ship).Select(c => new CellDto(c.X, c.Y, StateOf(ship, c)))
                ];
                return ShipOutline.FromCells(ship.Name, cells, cells.All(c => c.State == "sunk"));
            })
            .OfType<ShipOutline>()
    ];

    protected override void OnInitialized()
    {
        Appearance.OnChange += OnAppearanceChanged;
        _script = BuildScript();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // The battle is decoration, and decoration that moves must answer to both the app's
        // own Calm setting and the reader's operating system. A page that ignores the second
        // is a page someone has to leave.
        var reduced = false;
        try
        {
            reduced = await Js.InvokeAsync<bool>("battleshipSettings.prefersReducedMotion");
        }
        catch (JSException)
        {
            // Older bundle, or scripting restricted: assume motion is welcome rather than
            // silently showing a still page to everyone.
        }

        _frozen = reduced;
        await RestartAsync();
    }

    private async Task RestartAsync()
    {
        await StopAsync();

        if (_frozen || Appearance.Motion == "calm")
        {
            // Still, but not empty: the battle is shown part-played, so the page still says
            // what the game looks like.
            ReplayTo(_script.Length / 2);
            StateHasChanged();
            return;
        }

        _cts = new CancellationTokenSource();
        _ = RunAsync(_cts.Token);
    }

    private async Task RunAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(900));

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                Advance();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The component went away, or the player asked for calm. Both are ordinary.
        }
    }

    private void Advance()
    {
        // Three ticks of quiet at the end, so the finished board can be read before it is
        // wiped and the whole thing starts again.
        if (_step >= _script.Length + 3)
        {
            _resolved.Clear();
            _impact = null;
            _sunkLabel = null;
            _step = 0;
            return;
        }

        if (_step < _script.Length)
        {
            Fire(_script[_step]);
        }
        else
        {
            _impact = null;
            _sunkLabel = null;
        }

        _step++;
    }

    private void Fire(Coordinate at)
    {
        var ship = Fleet0.FirstOrDefault(s => CellsOf(s).Contains(at));
        var hit = ship.Name is not null;

        _resolved[at] = hit ? "hit" : "miss";

        var sank = hit && CellsOf(ship).All(c => _resolved.ContainsKey(c));
        _sunkLabel = sank ? $"{ship.Name} down" : null;
        _impact = new FiringGrid.ImpactMark(at, sank ? "sunk" : hit ? "hit" : "miss", ++_sequence);
    }

    private void ReplayTo(int step)
    {
        _resolved.Clear();
        _impact = null;
        _sunkLabel = null;
        for (var i = 0; i < step && i < _script.Length; i++)
            _resolved[_script[i]] = Fleet0.Any(s => CellsOf(s).Contains(_script[i])) ? "hit" : "miss";
    }

    /// <summary>
    /// Two misses, then a ship taken apart, and again. The rhythm matters more than the
    /// content: an uninterrupted run of hits reads as a cheat, and an uninterrupted run of
    /// misses reads as nothing happening.
    /// </summary>
    private static Coordinate[] BuildScript()
    {
        var script = new List<Coordinate>();
        var miss = 0;

        foreach (var ship in Fleet0)
        {
            script.Add(Misses[miss++ % Misses.Length]);
            script.Add(Misses[miss++ % Misses.Length]);
            script.AddRange(CellsOf(ship));
        }

        return [.. script];
    }

    private static IEnumerable<Coordinate> CellsOf((string Name, Coordinate Origin, bool Vertical, int Size) ship)
    {
        for (var i = 0; i < ship.Size; i++)
            yield return ship.Vertical
                ? new Coordinate(ship.Origin.X, ship.Origin.Y + i)
                : new Coordinate(ship.Origin.X + i, ship.Origin.Y);
    }

    private string StateOf((string Name, Coordinate Origin, bool Vertical, int Size) ship, Coordinate cell)
    {
        if (!_resolved.ContainsKey(cell))
            return "ship";

        return CellsOf(ship).All(c => _resolved.ContainsKey(c)) ? "sunk" : "hit";
    }

    private IEnumerable<(Coordinate At, string State)> AllShipCells() =>
        Fleet0.SelectMany(ship => CellsOf(ship).Select(cell => (cell, StateOf(ship, cell))));

    private void OnAppearanceChanged() => _ = RestartAsync();

    private async Task StopAsync()
    {
        if (_cts is null)
            return;

        await _cts.CancelAsync();
        _cts.Dispose();
        _cts = null;
    }

    public async ValueTask DisposeAsync()
    {
        Appearance.OnChange -= OnAppearanceChanged;
        await StopAsync();
    }
}

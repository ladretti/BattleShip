@page "/placement"
@implements IDisposable
@inject GameState State
@inject NavigationManager Navigation

<PageTitle>Place your fleet — Battleship</PageTitle>

<h1 class="page-title">Lay out your fleet.</h1>

@if (State.Current is null)
{
    <div class="alert alert--note" role="alert">
        <span class="alert__title">No game in progress.</span>
        <p><a href="">Create one first.</a></p>
    </div>
}
else if (State.Current.Status != "Placing")
{
    <div class="alert alert--note" role="alert">
        <span class="alert__title">This fleet is already placed.</span>
        <p><a href="play">Go to the game.</a></p>
    </div>
}
else
{
    var game = State.Current;

    <p class="lede">
        Click a square to drop the highlighted ship. Click a ship again to take it back.
        Press <kbd>R</kbd> to turn it.
    </p>

    <div class="stage">
        <div class="stage__board">
            <PlacementGrid GridSize="game.Own.GridSize"
                           Placed="_placed"
                           Preview="_preview"
                           PreviewIsValid="_previewIsValid"
                           OnCellClick="PlaceOrRemoveAsync"
                           OnCellPointed="PointAt"
                           OnRotate="Rotate" />
        </div>

        <aside class="stage__side panel">
            <h2 class="panel__title">Fleet</h2>

            <ul class="fleet">
                @foreach (var template in game.Fleet)
                {
                    var isPlaced = _placed.Any(p => p.Name == template.Name);
                    var isNext = NextShip?.Name == template.Name;
                    <li class="fleet__ship" data-active="@isNext.ToString().ToLowerInvariant()">
                        <span class="fleet__name">@template.Name</span>
                        <span class="fleet__note">
                            @(isPlaced ? "placed" : isNext ? "place it now" : $"{template.Size} squares")
                        </span>
                        <span class="hull" aria-hidden="true">
                            @for (var i = 0; i < template.Size; i++)
                            {
                                <span class="hull__pip" data-state="@(isPlaced ? "ship" : "empty")"></span>
                            }
                        </span>
                    </li>
                }
            </ul>

            <div class="stage__actions">
                <button class="button" @onclick="Rotate" disabled="@IsBusy">
                    Turn — @_orientation
                </button>
                <button class="button" @onclick="Reset" disabled="@IsBusy">Clear</button>
            </div>

            <button class="button button--primary stage__confirm"
                    @onclick="ValidateAsync"
                    disabled="@(IsBusy || _placed.Count != game.Fleet.Count)">
                @(IsBusy ? "Sending…" : "Confirm fleet")
            </button>

            @if (!game.ShipsMayTouch)
            {
                <p class="fleet__note stage__rule">Ships may not touch, diagonals included.</p>
            }
        </aside>
    </div>

    @* The three states. The preview hint is local and advisory; the alert below carries
       what the SERVER said, which is the only verdict that counts (ADR 0007). *@
    <p class="status" role="status" aria-live="polite">
        @if (IsBusy)
        {
            <span class="busy" aria-hidden="true"></span>
            <span>Sending the fleet…</span>
        }
        else if (_preview is not null && !_previewIsValid && NextShip is { } blocked)
        {
            <span>@blocked.Name would not fit there — you can still drop it, and the server will say why.</span>
        }
    </p>

    @if (PlacedFleetClashes(game))
    {
        <div class="alert alert--note" role="status">
            <span class="alert__title">Two of your ships are touching.</span>
            <p>
                Click one to take it back and put it somewhere else. You can still confirm as
                it is — the server will refuse it and tell you why.
            </p>
        </div>
    }

    @if (!IsBusy && State.State == LoadState.Failed)
    {
        <div class="alert alert--error" role="alert">
            <span class="alert__title">The server refused this fleet.</span>
            <p>@State.ErrorMessage</p>
        </div>
    }
}

@code {
    private readonly List<ShipPlacement> _placed = [];
    private Orientation _orientation = Orientation.Horizontal;
    private ShipPlacement? _preview;
    private bool _previewIsValid;

    private bool IsBusy => State.State == LoadState.Loading;

    /// <summary>The first ship of the fleet that has not been laid down yet.</summary>
    private ShipTemplateDto? NextShip => State.Current?.Fleet
        .FirstOrDefault(t => _placed.All(p => p.Name != t.Name));

    protected override void OnInitialized() => State.OnChange += OnStateChanged;

    private void Rotate()
    {
        _orientation = _orientation == Orientation.Horizontal ? Orientation.Vertical : Orientation.Horizontal;
        RecomputePreview(_preview?.Origin);
    }

    private void Reset()
    {
        _placed.Clear();
        ClearPreview();
    }

    private void ClearPreview()
    {
        _preview = null;
        _previewIsValid = false;
    }

    private void PointAt(Coordinate cell) => RecomputePreview(cell);

    private Task PlaceOrRemoveAsync(Coordinate cell)
    {
        // Clicking a ship takes it back, which is the only way to move one that was put in
        // the wrong place without clearing the whole fleet.
        var existing = _placed.FirstOrDefault(p => p.Cells().Contains(cell));
        if (existing is not null)
        {
            _placed.Remove(existing);
            ClearPreview();
            return Task.CompletedTask;
        }

        if (Candidate(cell) is not { } candidate)
            return Task.CompletedTask;

        // Deliberately placed even when the preview says it will not do. The preview is a
        // comfort; refusing the click here would make the server's own refusal
        // undemonstrable, and would put a rule in the front (ADR 0007).
        _placed.Add(candidate);

        // Dropped rather than recomputed for the NEXT ship at the same spot: that preview
        // would sit right on top of the ship just laid down and hide it behind an "invalid"
        // overlay the player never asked for. It comes back as soon as the pointer moves.
        ClearPreview();
        return Task.CompletedTask;
    }

    private async Task ValidateAsync()
    {
        var ships = _placed
            .Select(p => new ShipPlacementInput(p.Name, p.Origin.X, p.Origin.Y, p.Orientation.ToString()))
            .ToList();

        await State.PlaceFleetAsync(ships);

        if (State.State == LoadState.Ready)
            Navigation.NavigateTo("/play");
    }

    /// <summary>Where the ship being placed would land, or <c>null</c> if the fleet is complete.</summary>
    private ShipPlacement? Candidate(Coordinate origin) =>
        NextShip is { } next ? new ShipPlacement(next.Name, origin, _orientation, next.Size) : null;

    /// <summary>
    /// Asks the domain — <see cref="PlacementRules.Validate"/>, the very rule the server
    /// runs — whether the candidate fits, instead of reimplementing bounds, overlap and
    /// adjacency in the front. The trick for validating an incomplete fleet is the one
    /// <c>FleetPlacer</c> already uses: describe to the rule the partial fleet actually
    /// being checked.
    /// </summary>
    private void RecomputePreview(Coordinate? origin)
    {
        if (State.Current is not { } game || origin is not { } cell || Candidate(cell) is not { } candidate)
        {
            ClearPreview();
            return;
        }

        _preview = candidate;
        _previewIsValid = CandidateFits(game, candidate);
    }

    /// <summary>
    /// Whether the ship being placed would be accepted where it is pointing.
    ///
    /// <para>It asks the domain — <see cref="PlacementRules.Validate"/>, the very rule the
    /// server runs — but asks it about the candidate ALONE and then about the candidate
    /// PAIRED with each ship already down, never about the whole fleet at once.</para>
    ///
    /// <para>That is not a refinement, it is a correction. Validating the whole fleet made
    /// the preview blame the candidate for a problem it had nothing to do with: drop two
    /// ships touching each other — which this page deliberately allows, since the server is
    /// the authority — and from then on every square on the board answered "the ship would
    /// not fit here", including squares that were perfectly free. Pair by pair, the answer
    /// is about the candidate and only the candidate.</para>
    ///
    /// <para>ExtraTurnOnHit is irrelevant throughout: PlacementRules reads only GridSize,
    /// Fleet and ShipsMayTouch, which is also why it is not on the wire.</para>
    /// </summary>
    private bool CandidateFits(GameDto game, ShipPlacement candidate)
    {
        var alone = new GameRules(
            game.Own.GridSize,
            [new ShipTemplate(candidate.Name, candidate.Size)],
            game.ShipsMayTouch,
            ExtraTurnOnHit: true);

        if (!PlacementRules.Validate([candidate], alone).IsOk)
            return false;

        foreach (var placed in _placed)
        {
            var pair = new GameRules(
                game.Own.GridSize,
                [new ShipTemplate(placed.Name, placed.Size), new ShipTemplate(candidate.Name, candidate.Size)],
                game.ShipsMayTouch,
                ExtraTurnOnHit: true);

            if (!PlacementRules.Validate([placed, candidate], pair).IsOk)
                return false;
        }

        return true;
    }

    /// <summary>
    /// Whether the ships already laid down are legal among themselves. The page lets the
    /// player create this situation on purpose, so it has to be able to say so — otherwise
    /// the only feedback is a refusal from the server after pressing Confirm.
    /// </summary>
    private bool PlacedFleetClashes(GameDto game)
    {
        if (_placed.Count < 2)
            return false;

        var rules = new GameRules(
            game.Own.GridSize,
            [.. _placed.Select(p => new ShipTemplate(p.Name, p.Size))],
            game.ShipsMayTouch,
            ExtraTurnOnHit: true);

        return !PlacementRules.Validate([.. _placed], rules).IsOk;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnChange -= OnStateChanged;
}

@page "/"
@implements IDisposable
@inject GameState State
@inject NavigationManager Navigation

<PageTitle>New game — Battleship</PageTitle>

<h1 class="page-title">Take the bridge.</h1>

<p class="lede">
    Pick your waters and who you are up against. You place your own fleet next; the
    opponent's is already out there, and the server is the only one who knows where.
</p>

<div class="new-game">
    <div class="field">
        <label class="field__label" for="grid-size">Grid</label>
        <select id="grid-size" @bind="_gridSize" disabled="@IsBusy">
            @foreach (var size in GridSizes)
            {
                <option value="@size">@size × @size</option>
            }
        </select>
    </div>

    <div class="field">
        <label class="field__label" for="difficulty">Opponent</label>
        @* Read from the shared contract, never from three strings typed here: the server
           rejects anything outside this list (ADR 0008). *@
        <select id="difficulty" @bind="_difficulty" disabled="@IsBusy">
            @foreach (var level in DifficultyLevels.All)
            {
                <option value="@level">@level — @Describe(level)</option>
            }
        </select>
    </div>

    <button class="button button--primary" @onclick="CreateAsync" disabled="@IsBusy">
        @(IsBusy ? "Creating…" : "Create game")
    </button>
</div>

@* The three states, all rendered. A failure leaves every control above usable, so the
   player can simply try again once the API is back up (ADR 0007). *@
<p class="status" role="status" aria-live="polite">
    @if (IsBusy)
    {
        <span class="busy" aria-hidden="true"></span>
        <span>Creating the game…</span>
    }
</p>

@if (!IsBusy && State.State == LoadState.Failed)
{
    <div class="alert alert--error" role="alert">
        <span class="alert__title">Could not create the game.</span>
        <p>@State.ErrorMessage</p>
    </div>
}

@code {
    // Bounded by CreateGameInputValidator, which accepts 7 to 20 — and by the fact that the
    // default fleet admits no legal placement at all below 7 under the non-adjacency rule.
    // A handful of sizes as a list, rather than a free number field, keeps the page from
    // offering anything the server would refuse.
    private static readonly int[] GridSizes = [8, 10, 12, 15];

    private int _gridSize = 10;
    private string _difficulty = DifficultyLevels.Normal;

    private bool IsBusy => State.State == LoadState.Loading;

    protected override void OnInitialized() => State.OnChange += OnStateChanged;

    /// <summary>
    /// What each level actually does, in the player's terms rather than the algorithm's.
    /// "Hard" is flagged as punishing because it is: see the measured shot counts in the
    /// README.
    /// </summary>
    private static string Describe(string level) => level switch
    {
        DifficultyLevels.Easy => "fires at random",
        DifficultyLevels.Normal => "hunts down what it hits",
        DifficultyLevels.Hard => "reads the board, and wins",
        _ => ""
    };

    private async Task CreateAsync()
    {
        await State.CreateAsync(_gridSize, _difficulty);

        // Navigate only on success: on failure the player stays here, sees why, and retries.
        if (State.State == LoadState.Ready)
            Navigation.NavigateTo("/placement");
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    // Without this, GameState — which outlives every page — would keep this component alive
    // and re-render it after it was destroyed (ADR 0007).
    public void Dispose() => State.OnChange -= OnStateChanged;
}

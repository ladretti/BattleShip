@page "/play"
@implements IDisposable
@inject GameState State
@inject BattleGrpcClient Grpc
@inject BattleApiClient Api
@inject NavigationManager Navigation

<PageTitle>Battle — Battleship</PageTitle>

@if (State.Current is null)
{
    <h1 class="page-title">Nothing under way.</h1>
    <div class="alert alert--note" role="alert">
        <span class="alert__title">No game in progress.</span>
        <p><a href="">Create one first.</a></p>
    </div>
}
else if (State.Current.Status == "Placing")
{
    <h1 class="page-title">Your fleet is still on the dock.</h1>
    <div class="alert alert--note" role="alert">
        <span class="alert__title">Place it before you fire.</span>
        <p><a href="placement">Go to placement.</a></p>
    </div>
}
else
{
    var game = State.Current;
    var finished = game.Status == "Finished";
    var won = PlayerWon(game);

    @if (finished)
    {
        <h1 class="page-title">@(won ? "Their fleet is gone." : "Your fleet is gone.")</h1>
        <div class="alert @(won ? "alert--note" : "alert--error")" role="alert">
            <span class="alert__title">@(won ? "You win." : "You lose.")</span>
            <p>Every ship of the losing fleet has been sunk.</p>
            <button class="button button--primary stage__confirm" @onclick="NewGame">New game</button>
        </div>
    }
    else
    {
        <h1 class="page-title">Their waters.</h1>
        <p class="lede">
            @game.OpponentDifficulty. Pick a square and fire — a hit buys you another shot.
        </p>
    }

    <div class="stage">
        @* The hero: the board you act on, at full size. Everything else is smaller on
           purpose — two equal grids side by side told the player nothing about where to
           look, and this game is only ever played on one of them. *@
        <div class="stage__board">
            <FiringGrid @ref="_opponentGrid"
                        GridSize="game.Opponent.GridSize"
                        Cells="OpponentCells(game)"
                        Ships="OpponentHulls(game)"
                        Label="Opponent board — choose a square to fire at"
                        Interactive="@(!finished && !_firing && _replayCursor is null)"
                        Impact="_opponentImpact"
                        SunkLabel="@_sunkLabel"
                        OnCellClick="FireAsync" />
            <p class="board-caption">
                Sunk @game.Opponent.SunkShips.Count of @game.Fleet.Count
                @if (_streak > 1)
                {
                    <span class="streak">@_streak hits in a row</span>
                }
            </p>
        </div>

        <aside class="stage__side panel">
            <h2 class="panel__title">Your fleet</h2>

            <div class="own-board">
                <FiringGrid GridSize="game.Own.GridSize"
                            Cells="OwnCells(game)"
                            Ships="OwnHulls(game)"
                            Compact="true"
                            Label="Your board"
                            Impact="_ownImpact"
                            Interactive="false" />
            </div>

            @* Hull integrity per ship, rather than a count. It answers the question the
               player actually has — which ship is about to go — and it is read straight
               from the cells the server sent. *@
            <ul class="fleet">
                @foreach (var ship in game.Own.Ships)
                {
                    <li class="fleet__ship" data-sunk="@ship.IsSunk.ToString().ToLowerInvariant()">
                        <span class="fleet__name">@ship.Name</span>
                        <span class="fleet__note">
                            @(ship.IsSunk ? "sunk" : $"{ship.Cells.Count(c => c.State == "hit")} of {ship.Size} hit")
                        </span>
                        <span class="hull" aria-hidden="true">
                            @foreach (var cell in ship.Cells)
                            {
                                <span class="hull__pip" data-state="@cell.State"></span>
                            }
                        </span>
                    </li>
                }
            </ul>
        </aside>
    </div>

    @* The running commentary, and the one region a screen reader listens to. It is rendered
       UNCONDITIONALLY: a live region that appears and disappears with the state it reports
       is unreliable — assistive technology must already be observing the node when its text
       changes. Only the text inside it varies. *@
    <p class="status" role="status" aria-live="polite">
        @if (_firing)
        {
            <span class="busy" aria-hidden="true"></span>
        }
        <span>@_announcement</span>
    </p>

    @if (_shotError is not null)
    {
        <div class="alert alert--error" role="alert">
            <span class="alert__title">Shot refused.</span>
            <p>@_shotError</p>
        </div>
    }
    else if (State.State == LoadState.Failed)
    {
        <div class="alert alert--error" role="alert">
            <span class="alert__title">Could not read the board.</span>
            <p>@State.ErrorMessage</p>
        </div>
    }

    @if (_replayCursor is not null)
    {
        <div class="alert alert--note" role="status">
            <span class="alert__title">Replaying.</span>
            <p>
                The boards show the game after @_replayCursor of @_history.Count shots.
                Firing is off until you go back to live — nothing here is sent to the server.
            </p>
        </div>
    }

    <HistoryPanel Shots="_history" Cursor="_replayCursor" CursorChanged="SetReplayCursor" />

    @* Required by the subject: an EXPECTED gRPC-Web error, demonstrable from the browser.
       Firing twice at the same cell gives InvalidArgument; this button gives NotFound,
       which no legitimate click can produce since the page only ever fires at the game it
       is showing. See README, "Démonstration gRPC-Web". *@
    <details class="drawer">
        <summary>gRPC-Web diagnostics</summary>
        <p class="fleet__note">
            Fires at a game id that does not exist, so you can watch an expected
            <code>NotFound</code> come back over gRPC-Web in the Network tab.
        </p>
        <button class="button" @onclick="FireAtUnknownGameAsync" disabled="@_firing">
            Fire at an unknown game
        </button>
    </details>
}

@code {
    /// <summary>
    /// Shots received since the last read of the board, drawn on top of it so the sequence
    /// can be played back one cell at a time. They are dropped as soon as the authoritative
    /// state is re-read — they are an animation, never a second source of truth.
    /// </summary>
    private readonly List<CellDto> _opponentOverlay = [];
    private readonly List<CellDto> _ownOverlay = [];

    private bool _firing;
    private string? _shotError;

    /// <summary>
    /// What the live region says. Kept after the exchange ends rather than cleared, so a
    /// player who missed the announcement can still read the last result.
    /// </summary>
    private string _announcement = "Your move.";

    /// <summary>The whole shot history, re-read after every exchange. Feeds the replay.</summary>
    private IReadOnlyList<ShotDto> _history = [];

    /// <summary>
    /// How many shots the boards draw, or <c>null</c> for the live game. Purely a rendering
    /// concern: nothing about it ever reaches the server.
    /// </summary>
    private int? _replayCursor;

    private FiringGrid? _opponentGrid;

    /// <summary>
    /// The cell to put focus back on once the board has been re-rendered as buttons again.
    /// Deferred to OnAfterRenderAsync rather than done inline: the element to focus does not
    /// exist yet at the end of the exchange.
    /// </summary>
    private Coordinate? _refocus;

    private FiringGrid.ImpactMark? _opponentImpact;
    private FiringGrid.ImpactMark? _ownImpact;
    private string? _sunkLabel;

    /// <summary>Counts the run of hits "hit = fire again" has given the player.</summary>
    private int _streak;

    /// <summary>
    /// Every impact carries one, and it only ever goes up. It is what tells Blazor to build
    /// a NEW burst element rather than reuse the old one — without it, firing twice at the
    /// same result would leave the first animation frozen mid-flight.
    /// </summary>
    private int _impactSequence;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChanged;
        await LoadHistoryAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_refocus is not { } cell || _opponentGrid is null)
            return;

        // Cleared only once it actually worked. The renders that happen DURING the exchange
        // draw an inert board, so the first attempt necessarily fails; dropping the request
        // then would leave focus on the document body, which is the bug this exists to fix.
        if (await _opponentGrid.FocusCellAsync(cell))
            _refocus = null;
    }

    private IReadOnlyList<CellDto> OpponentCells(GameDto game)
    {
        if (_replayCursor is { } cursor)
            return [.. _history.Take(cursor).Where(s => s.By == "Human").Select(ToCell)];

        return
        [
            .. game.Opponent.Shots,
            // Sunk ships come last so their cells override the "hit" that revealed them.
            .. game.Opponent.SunkShips.SelectMany(s => s.Cells),
            .. _opponentOverlay
        ];
    }

    private IReadOnlyList<CellDto> OwnCells(GameDto game)
    {
        // The player's own ships are drawn in every case: they are the player's, so hiding
        // them during a replay would withhold nothing and only make the replay unreadable.
        if (_replayCursor is { } cursor)
            return
            [
                .. game.Own.Ships.SelectMany(s => s.Cells).Select(c => c with { State = "ship" }),
                .. _history.Take(cursor).Where(s => s.By == "Opponent").Select(ToCell)
            ];

        return
        [
            .. game.Own.Ships.SelectMany(s => s.Cells),
            .. game.Own.ReceivedShots,
            .. _ownOverlay
        ];
    }

    private static CellDto ToCell(ShotDto shot) => new(shot.X, shot.Y, shot.Result);

    /// <summary>
    /// Your fleet as hulls. Each ship's cells are re-read from what the board is CURRENTLY
    /// showing — which during a replay is the replayed state, not the live one — so the
    /// scars on a hull always agree with the cells around it.
    /// </summary>
    private IReadOnlyList<ShipOutline> OwnHulls(GameDto game)
    {
        var shown = new Dictionary<Coordinate, string>();
        foreach (var cell in OwnCells(game))
            shown[new Coordinate(cell.X, cell.Y)] = cell.State;

        return
        [
            .. game.Own.Ships
                .Select(ship =>
                {
                    IReadOnlyList<CellDto> cells =
                    [
                        .. ship.Cells.Select(c => c with
                        {
                            State = shown.GetValueOrDefault(new Coordinate(c.X, c.Y), c.State)
                        })
                    ];

                    // Derived, not taken from the live DTO: during a replay the ship may not
                    // have been sunk yet at the cursor's position.
                    var sunk = cells.All(c => c.State is "hit" or "sunk");
                    return ShipOutline.FromCells(ship.Name, cells, sunk);
                })
                .OfType<ShipOutline>()
        ];
    }

    /// <summary>
    /// The opponent's hulls: only the wrecks, because only a sunk ship has cells on the wire
    /// at all (ADR 0001). An afloat opposing ship has nothing to draw, which is the secrecy
    /// rule holding by construction rather than by care.
    /// </summary>
    private static IReadOnlyList<ShipOutline> OpponentHulls(GameDto game) =>
    [
        .. game.Opponent.SunkShips
            .Select(ship => ShipOutline.FromCells(ship.Name, ship.Cells, isSunk: true))
            .OfType<ShipOutline>()
    ];

    private void SetReplayCursor(int? cursor) => _replayCursor = cursor;

    /// <summary>
    /// A failed history read is not worth an error banner: the history is an extra, and the
    /// game stays entirely playable without it. It is simply left as it was.
    /// </summary>
    private async Task LoadHistoryAsync()
    {
        if (State.Current is not { } game)
            return;

        var result = await Api.GetHistoryAsync(game.Id);
        if (result.IsOk)
            _history = result.Value;
    }

    /// <summary>
    /// Read from the board the server sent, not decided here: the game is over and the
    /// opponent's whole fleet is sunk, so the player is the one still standing.
    /// </summary>
    private static bool PlayerWon(GameDto game) => game.Opponent.SunkShips.Count == game.Fleet.Count;

    private async Task FireAsync(Coordinate at)
    {
        if (State.Current is not { } game || _firing)
            return;

        await RunShotAsync(game.Id, at);
    }

    /// <summary>
    /// The expected-error demonstration: a well-formed but unknown game id, which
    /// <c>FireRequestValidator</c> lets through on purpose (an unknown game is a business
    /// refusal, not a malformed request) and which the engine answers with
    /// <c>GameNotFound</c> → <c>StatusCode.NotFound</c>.
    /// </summary>
    private async Task FireAtUnknownGameAsync() =>
        // restoreFocus: false — the shot targets a game that does not exist, so there is no
        // cell of THIS board it would make sense to move focus to. The player stays on the
        // diagnostics button they just pressed.
        await RunShotAsync(Guid.NewGuid(), new Coordinate(0, 0), restoreFocus: false);

    private async Task RunShotAsync(Guid gameId, Coordinate at, bool restoreFocus = true)
    {
        if (restoreFocus)
            _refocus = at;

        // Cleared BEFORE the call, and left cleared for at least one render. The board
        // flinches through `:has(.impact--hit)`, and a CSS animation only restarts when the
        // element starts matching again — so two hits in a row need a frame with no impact
        // in between, or the second one would land in silence.
        _opponentImpact = null;
        _ownImpact = null;
        _sunkLabel = null;

        _firing = true;
        _shotError = null;
        _announcement = "Firing…";

        var result = await Grpc.FireAsync(gameId, at);

        if (!result.IsOk)
        {
            _shotError = result.ErrorMessage;
            _announcement = result.ErrorMessage ?? "The shot was refused.";
            _firing = false;
            _streak = 0;

            // A refusal can mean this page is looking at a stale board — someone else's
            // shot, a restarted API. Re-reading costs one request and removes the doubt.
            await State.RefreshAsync();
            return;
        }

        var response = result.Value;

        _opponentOverlay.Add(new CellDto(response.PlayerShot.X, response.PlayerShot.Y, response.PlayerShot.Result));
        _opponentImpact = new FiringGrid.ImpactMark(
            new Coordinate(response.PlayerShot.X, response.PlayerShot.Y),
            response.PlayerShot.Result,
            ++_impactSequence);
        _sunkLabel = string.IsNullOrEmpty(response.PlayerShot.SunkShipName)
            ? null
            : $"{response.PlayerShot.SunkShipName} down";
        _streak = response.PlayerShot.Result == "miss" ? 0 : _streak + 1;
        _announcement = Announce("Your shot", response.PlayerShot);
        StateHasChanged();

        // The response carries a whole sequence — "hit = fire again" (ADR 0006) means the
        // opponent may answer with several shots in a row. Showing them all at once would
        // hide what actually happened, so they are unrolled with a short pause.
        foreach (var shot in response.OpponentShots)
        {
            await Task.Delay(520);
            _ownOverlay.Add(new CellDto(shot.X, shot.Y, shot.Result));
            _ownImpact = new FiringGrid.ImpactMark(
                new Coordinate(shot.X, shot.Y), shot.Result, ++_impactSequence);
            _announcement = Announce("Opponent fires", shot);
            StateHasChanged();
        }

        await Task.Delay(420);

        // The server is re-read rather than trusted to match what was just drawn: it is the
        // one that knows which ships are sunk and whether the game is over (ADR 0007).
        await State.RefreshAsync();
        await LoadHistoryAsync();
        _opponentOverlay.Clear();
        _ownOverlay.Clear();
        _firing = false;

        if (State.Current is { Status: "Finished" } ended)
        {
            _streak = 0;
            _announcement = PlayerWon(ended)
                ? "You win. Every opposing ship is sunk."
                : "You lose. Your fleet is sunk.";
        }
    }

    /// <summary>
    /// One sentence per shot, spelled out for a listener: the square named the way the
    /// rulers name it, and the sunk ship named when there is one.
    /// </summary>
    private static string Announce(string who, BattleShip.API.Grpc.Shot shot)
    {
        var square = $"{(char)('A' + shot.X)}{shot.Y + 1}";
        var sunk = string.IsNullOrEmpty(shot.SunkShipName) ? "" : $" {shot.SunkShipName} is sunk.";
        return $"{who} at {square}: {shot.Result}.{sunk}";
    }

    private void NewGame() => Navigation.NavigateTo("/");

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnChange -= OnStateChanged;
}

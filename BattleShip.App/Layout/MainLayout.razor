@inherits LayoutComponentBase
@implements IDisposable
@inject GameState State
@inject AppearanceState Appearance

<div class="shell">
    <header class="masthead">
        <a class="masthead__name" href="">Battleship</a>

        @* Shown only when there is a game, and read straight from what the server sent.
           The level is never chosen from here: changing it mid-game would change the
           opponent under the player's feet. *@
        @if (State.Current is { } game)
        {
            <span class="masthead__state">
                @game.OpponentDifficulty · @game.Own.GridSize × @game.Own.GridSize ·
                @(game.Status switch
                {
                    "Placing" => "placing your fleet",
                    "Finished" => "game over",
                    _ => "in play"
                })
            </span>
        }

        <span class="masthead__spacer"></span>
        <SettingsMenu />
    </header>

    <main class="main">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnChanged;
        Appearance.OnChange += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The page already applied the stored settings before Blazor booted; this is the one
        // moment they are read back into C# so the settings panel opens on the right values.
        if (firstRender)
            await Appearance.InitializeAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.OnChange -= OnChanged;
        Appearance.OnChange -= OnChanged;
    }
}

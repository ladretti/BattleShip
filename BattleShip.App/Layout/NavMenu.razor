@implements IDisposable
@inject GameState State

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BattleShip</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> New game
            </NavLink>
        </div>
        @* Shown only once there is a game to place or play: a link to a page that would
           only say "no game in progress" is a dead end offered to the player. *@
        @if (State.Current is not null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="placement">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Placement
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="play">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Play
                </NavLink>
            </div>
        }
    </nav>

    @* The level is shown, never chosen from here: changing it mid-game would mean changing
       the opponent under the player's feet. Creating another game is the way to change it. *@
    @if (State.Current is { } game)
    {
        <div class="px-3 py-2 small text-white-50">
            Opponent: @game.OpponentDifficulty · Grid: @game.Own.GridSize × @game.Own.GridSize
        </div>
    }
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized() => State.OnChange += OnStateChanged;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    // This layout component is long-lived, but it subscribes like any other and must
    // unsubscribe like any other (ADR 0007).
    public void Dispose() => State.OnChange -= OnStateChanged;
}

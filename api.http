@api = https://localhost:7050

### Create a game
POST {{api}}/games
Content-Type: application/json

{ "gridSize": 10, "difficulty": "Normal" }

### Get a game
GET {{api}}/games/{{gameId}}

### Place the fleet
# Default fleet (GameRules.Default): Carrier 5, Battleship 4, Cruiser 3, Submarine 3,
# Destroyer 2. These names are the canonical English Battleship nomenclature, a
# redesignation and NOT a word-for-word translation of the former French names: Cruiser
# is the size 3 ship, not the size 4 one, and Destroyer is the size 2 ship, not the
# size 3 one. The sizes (5, 4, 3, 3, 2) are what matters functionally and they have
# not changed.
POST {{api}}/games/{{gameId}}/placement
Content-Type: application/json

{
  "ships": [
    { "name": "Carrier", "x": 0, "y": 0, "orientation": "Horizontal" },
    { "name": "Battleship", "x": 0, "y": 2, "orientation": "Horizontal" },
    { "name": "Cruiser", "x": 0, "y": 4, "orientation": "Horizontal" },
    { "name": "Submarine", "x": 0, "y": 6, "orientation": "Horizontal" },
    { "name": "Destroyer", "x": 0, "y": 8, "orientation": "Horizontal" }
  ]
}

### Get the shot history
GET {{api}}/games/{{gameId}}/history

### Benchmark: run 200 games
POST {{api}}/benchmark
Content-Type: application/json

{ "games": 200, "seed": 20260915 }

### Note on firing
# Firing has no HTTP route: none was ever planned for it. It goes exclusively through
# gRPC-Web (decision ADR 0005, task 14). The demonstration is done from the browser
# (F12 console).
